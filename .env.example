# Argus environment variables — SECRETS ONLY
# Non-secret settings belong in config, not here.

# LLM provider (OmniRoute-compatible endpoint).
# base_url defaults to http://127.0.0.1:20128/v1 when unset.
# api_key falls back to HERMES_CUSTOM_LOCALHOST_20128_API_KEY, which is the
# key OmniRoute accepts. Any non-empty bearer token works.
HERMES_CUSTOM_LOCALHOST_20128_API_KEY=your-api-key-here

# Default model / combo used by `argus ask` (OmniRoute combo name or model id).
ARGUS_DEFAULT_MODEL=Cadangan

# Secret vault passphrase (used by argus.secretvault). Keep it long and random.
ARGUS_VAULT_PASSPHRASE=change-me
